{
  "name": "ichess-desktop",
  "version": "0.1.0",
  "description": "Independent, offline-first chess workstation for Windows",
  "private": true,
  "author": "iChess contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "app:dev": "concurrently -k \"npm:dev\" \"npm:electron:dev\"",
    "electron:dev": "wait-on http://127.0.0.1:5173 && cross-env ICHESS_DEV_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "app:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "node --test"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.ichess.desktop",
    "productName": "iChess Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "iChess-Desktop-${version}-Portable.${ext}"
    },
    "artifactName": "iChess-Desktop-${version}-${arch}.${ext}"
  }
}
